{
  "name": "fastfigure",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5178",
    "build": "vue-tsc --noEmit && vite build && node scripts/build-server.mjs",
    "preview": "vite preview --host 127.0.0.1 --port 4178",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run",
    "lint": "eslint src server --max-warnings=0",
    "test:ui": "node tests/ui/run.mjs",
    "resources:build": "node scripts/build-reference-resources.mjs",
    "benchmark:build": "node scripts/build-reconstruction-benchmark.mjs",
    "benchmark:evaluate": "node scripts/evaluate-reconstruction-benchmark.mjs",
    "benchmark:controls": "node scripts/reconstruction-benchmark-controls.mjs",
    "benchmark:audit-context": "node scripts/evaluate-visual-audit-context.mjs",
    "benchmark:retrieval": "node scripts/evaluate-component-retrieval.mjs",
    "start": "bun server-dist/server.mjs"
  },
  "dependencies": {
    "roughjs": "^4.6.6",
    "svgpath": "^2.6.0",
    "vue": "^3.5.44",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.5",
    "@vitejs/plugin-vue": "^6.0.10",
    "@xmldom/xmldom": "^0.9.12",
    "eslint": "^10.13.0",
    "eslint-plugin-vue": "^10.12.0",
    "playwright-core": "^1.64.1",
    "typescript": "^6.0.2",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "^3.3.13"
  }
}
